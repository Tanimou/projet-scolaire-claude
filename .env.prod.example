# =============================================================================
# Pilotage Scolaire — PRODUCTION env (template). Copy to .env.prod (gitignored)
# and fill the secrets. Consumed by scripts/deploy-prod.sh +
# infra/docker-compose.prod.yml. Browser-facing URLs MUST be the real origin.
# =============================================================================

# ---- Public origin (served by the host's Traefik over TLS) ----
PUBLIC_BASE_URL=https://pilotage.srv861861.hstgr.cloud
PUBLIC_HOST=pilotage.srv861861.hstgr.cloud

# ---- NextAuth/Auth.js session-signing secret (generate: openssl rand -hex 32) ----
AUTH_SECRET=__CHANGE_ME__min_32_chars__

# ---- Compte d'administration Keycloak lu par l'API (S-E06-1 / PF-54) ----
# REQUIS. L'API n'a plus de défaut `?? 'admin'` : sans ces deux clés,
# `infra/docker-compose.prod.yml` refuse la commande de déploiement en les
# nommant — l'échec se produit dans le terminal, pas en boucle de crash sur le
# serveur.
#
# Valeurs actuelles de la stack hébergée : admin / admin. Les changer ici ne
# suffit PAS : il faut d'abord changer le mot de passe dans Keycloak lui-même
# (les variables du service `keycloak` ne créent l'administrateur qu'au tout
# premier démarrage). La rotation est une action opérateur, pas une action de
# cette story.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ---- Demo seed password for the provisioned Keycloak demo users ----
KEYCLOAK_DEMO_PASSWORD=Demo!2024Pilotage

# ---- Classification du déploiement + opt-in de seed (S-E02-4 / PF-03, R-12) ----
# `DEPLOY_ENV` décrit ce que ce déploiement EST, indépendamment du `NODE_ENV` de
# chaque service. Non déclaré, il retombe sur `production` : le défaut est fermé.
#
# Les sept scripts de seed refusent et sortent en 1 tant que les DEUX conditions
# ne sont pas réunies : une cible non-production ET le jeton exact ci-dessous.
# `ALLOW_SEED` ne lève JAMAIS un refus de production (DNC-10).
#
# Stack de démonstration → décommenter les deux lignes, puis `deploy-prod.sh --seed`.
# Déploiement client      → les laisser commentées.
# Voir docs/runbooks/provision-demo-tenant.md.
# DEPLOY_ENV=demo
# ALLOW_SEED=provision-demo-data

# ---- Infra host-port bindings ----
# CRITICAL on this VPS: the firewall is OPEN, so every infra port is bound to
# 127.0.0.1 ONLY. Containers still talk over the internal docker network by
# service name; these host bindings are just for local debugging. nginx is NOT
# published to the host at all in prod — Traefik reaches it over `root_web`.
POSTGRES_PORT=127.0.0.1:5432
REDIS_PORT=127.0.0.1:6379
KEYCLOAK_PORT=127.0.0.1:8080
MINIO_PORT=127.0.0.1:9000
MINIO_CONSOLE_PORT=127.0.0.1:9001
MAILDEV_SMTP_PORT=127.0.0.1:1025
MAILDEV_WEB_PORT=127.0.0.1:1080
API_PORT=127.0.0.1:4000
WEB_PORT=127.0.0.1:3000
# nginx host ports — unused in prod (Traefik fronts it) but parametrised so they
# never collide with Traefik's 80/443. Bound to localhost as harmless no-ops.
HTTP_PORT=127.0.0.1:8090
HTTPS_PORT=127.0.0.1:8453

# ---- Provenance client d'audit (S-E04-3 / PF-31, ADR-036 D2/D3/D9) ----------
# N = 2 : Traefik (hote, TLS) -> nginx (conteneur) -> api. REQUIS : sans lui,
# infra/docker-compose.prod.yml refuse la commande de deploiement en le nommant.
# Si l'arete change, re-derouler la procedure ADR-036 D7 et reenregistrer la
# valeur DANS l'ADR, pas dans un commentaire a cote du code.
TRUST_PROXY_HOPS=2
# W = 2 : Traefik (hote, TLS) -> nginx (conteneur) -> web. Clef DISTINCTE de
# TRUST_PROXY_HOPS ci-dessus (celle-la compte les relais devant l'API) : le web
# joint l'API par l'origine publique, les deux chemins se comptent separement.
# REQUISE : sans elle, infra/docker-compose.prod.yml refuse la commande de
# deploiement en la nommant — plutot que de livrer la provenance inerte.
WEB_TRUST_PROXY_HOPS=2
# Secret partage web <-> api. Absent => provenance nulle (fail-safe, ADR-036 D4)
# et l'UI affiche « provenance non disponible ».
#
# PF-132 — VIDE EXPRES. Un gabarit qui expedie une valeur litterale la publie :
# copiee telle quelle, elle est connue de quiconque lit ce depot, et un jeton
# connu laisse n'importe quel appelant poser x-pilotage-client-ip et choisir ce
# que la piste de gouvernance retient de lui. Un blanc honnete vaut mieux qu'une
# provenance forgeable (ADR-036 D1/D4) — et le vide, ici, ne degrade que vers le
# NULL que l'UI annonce deja.
# Generer une valeur qui n'a jamais transite par git : openssl rand -hex 32
AUDIT_FORWARD_TOKEN=

# SCHOOL_TIMEZONE : le fuseau DECLARE de l etablissement (S-E03-8 / PF-406,
# ADR-078 sect. D3). Identifiant IANA, ex. Europe/Paris, Africa/Abidjan.
#
# Ce n est PAS TZ : on ne change pas l horloge du processus, on declare celle de
# l ecole. Le conteneur web tourne en UTC (node:22-alpine, aucun TZ pose) ; tant
# que l ancre calendrier derivait son decalage de getTimezoneOffset(), toutes
# les bornes glissaient d une heure et un conge  toute la journee  s affichait
# la veille sur les trois portails.
#
# Vide => defaut du code, identique a celui de School.timezone / Tenant.timezone
# dans schema.prisma : Europe/Paris. Une valeur illisible est journalisee puis
# remplacee par ce defaut NOMME, jamais par le fuseau du processus.
#
# Reglage de DEPLOIEMENT, pas de locataire : la source multi-tenant correcte est
# Tenant.timezone renvoye par une lecture portail (PF-406, volet 2).
SCHOOL_TIMEZONE=Europe/Paris
