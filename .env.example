# =============================================================================
# Pilotage Scolaire — env example
# Copier en .env (jamais commité). Toutes ces valeurs sont des défauts dev.
# =============================================================================

# ---- Ports exposés ----
# CE FICHIER EST LA SEULE SOURCE DES PORTS PUBLIÉS (PF-86).
# `infra/docker-compose.yml` n'a plus AUCUN défaut `${VAR:-…}` : sans ces
# variables, Compose REFUSE de démarrer en nommant la variable manquante, au
# lieu de démarrer silencieusement une pile différente de celle décrite ici.
# Les treize sont donc obligatoires — `cp .env.example .env` est l'étape
# d'installation, pas une suggestion.
#
# 5433 et 8180 (et non 5432/8080) : ce sont les valeurs que tout le reste du
# dépôt utilise déjà — apps/api/.env.example, les seeds, le runbook de restore,
# le drill. Ce fichier était le seul à décrire 5432/8080, donc le dépôt
# décrivait deux piles locales incompatibles sans dire laquelle était la vraie.
WEB_PORT=3000
API_PORT=4000
WORKER_HTTP_PORT=4001
POSTGRES_PORT=5433
REDIS_PORT=6379
KEYCLOAK_PORT=8180
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILDEV_SMTP_PORT=1025
MAILDEV_WEB_PORT=1080
JAEGER_UI_PORT=16686
# Profil `prod` (nginx) uniquement — mais Compose interpole le fichier ENTIER
# avant de filtrer les profils, donc ces deux-là sont requis même pour un
# `up` ordinaire.
HTTP_PORT=80
HTTPS_PORT=443

# ---- Database (Postgres 15) ----
DATABASE_URL=postgresql://pilotage:pilotage@localhost:5433/pilotage?schema=public
DATABASE_URL_APP=postgresql://app_user:app_user@localhost:5433/pilotage?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Keycloak ----
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=pilotage-scolaire
# Compte d'administration du realm master, utilisé par l'API pour les invitations,
# la MFA et les réinitialisations de mot de passe. REQUIS depuis S-E06-1 / PF-54 :
# l'API refuse de démarrer sans, au lieu de retomber silencieusement sur admin/admin.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_CLIENT_ID=portal-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-portal-admin
KEYCLOAK_TEACHER_CLIENT_ID=portal-teacher
KEYCLOAK_TEACHER_CLIENT_SECRET=change-me-portal-teacher
KEYCLOAK_PARENT_CLIENT_ID=portal-parent
KEYCLOAK_PARENT_CLIENT_SECRET=change-me-portal-parent
# Portail élève : client OIDC dédié depuis S-E01-4a / ADR-050 (il réutilisait
# `portal-parent`, ce qui rendait un jeton élève indiscernable d'un jeton parent).
# Un realm DÉJÀ importé ne reçoit pas ce client automatiquement — `realm-export.json`
# ne provisionne qu'au premier import : créez `portal-student` (ou réimportez le realm)
# AVANT de déployer, sinon la connexion élève échoue en `invalid_client`. Repli assumé
# et visible en attendant : KEYCLOAK_STUDENT_CLIENT_ID=portal-parent.
KEYCLOAK_STUDENT_CLIENT_ID=portal-student
KEYCLOAK_STUDENT_CLIENT_SECRET=change-me-portal-student
KEYCLOAK_API_CLIENT_ID=api-backend
KEYCLOAK_API_CLIENT_SECRET=change-me-api-backend

# ---- S3 / MinIO ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pilotage
S3_PUBLIC_BUCKET=pilotage-public
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniominio

# ---- Mail (dev: Maildev, prod: Resend/SendGrid) ----
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="Pilotage scolaire <no-reply@pilotage.local>"
RESEND_API_KEY=
# Web origin used by the worker to absolutise notification-email deep links.
WEB_PUBLIC_URL=http://localhost:3000

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=pilotage-api
LOG_LEVEL=debug

# ---- Frontend (Next.js public env) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=pilotage-scolaire
NEXT_PUBLIC_DEFAULT_LOCALE=fr-FR

# ---- App ----
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-a-very-long-random-string-min-32-chars
# NextAuth/Auth.js session-signing secret (REQUIRED by the web app — without it
# every /api/auth/* request 500s with MissingSecret). Min 32 chars in prod.
AUTH_SECRET=change-me-a-very-long-random-string-min-32-chars
WEBPUSH_VAPID_PUBLIC=
WEBPUSH_VAPID_PRIVATE=
WEBPUSH_VAPID_SUBJECT=mailto:contact@pilotage.local

# ---- Provenance client d'audit (S-E04-3 / PF-31, ADR-036) -------------------
# TRUST_PROXY_HOPS : nombre de proxys inverses entre le socket de l'API et le
# client. REQUIS (REQUIRED_ENV) et parse strictement : un entier decimal, sans
# signe, sans espace, 0..2 — aucune coercition, aucun defaut. Ici 0 : sur le
# profil app, nginx porte profiles: ["prod"] et ne tourne pas, donc aucun proxy
# n'est dans le chemin. En production c'est 2 (Traefik -> nginx -> api).
TRUST_PROXY_HOPS=0
# WEB_TRUST_PROXY_HOPS : le meme comptage, mais devant NEXT — clef DISTINCTE, et
# la distinction est le point : les deux chemins n'ont pas la meme profondeur, et
# une clef unique en rendrait un des deux silencieusement faux. Meme grammaire
# (entier decimal 0..2, aucune coercition). REQUISE par compose (forme `${VAR:?}`
# sur le service `web`) meme si le lecteur, lui, retombe sur 0 : cette retombee
# est sure mais INVISIBLE — sans la clef, aucune adresse client n'est jamais
# transmise et AuditLog.ipAddress reste NULL, pour toujours, sans autre signal
# qu'un console.warn. Ici 0 (aucun relais L7 devant Next sur le profil `app`) ;
# en production c'est 2 (Traefik -> nginx -> web).
WEB_TRUST_PROXY_HOPS=0
# AUDIT_FORWARD_TOKEN : secret partage web <-> api qui autorise les DEUX seams
# serveur d'apps/web a declarer l'adresse et le navigateur reels de l'operateur.
# OPTIONNEL par decision (ADR-036 D9) : absent, la provenance est nulle et l'UI
# le dit — jamais l'adresse d'un relais. JAMAIS prefixe NEXT_PUBLIC_ (Next
# l'inlinerait dans le bundle navigateur, donc chez chaque visiteur).
#
# PF-132 — LAISSE VIDE EXPRES, et ce vide EST la valeur sure.
# Un exemple qui expedie un jeton litteral est pire que la fonctionnalite
# eteinte : l'operateur qui copie ce fichier deploie un secret que le depot
# publie deja, donc n'importe quel appelant peut poser x-pilotage-client-ip et
# CHOISIR ce que la piste de gouvernance retient de lui — exactement la
# confiance aveugle qu'ADR-036 D1 refuse par ecrit, et la forme meme de PF-54
# (un identifiant par defaut publie dans un depot public).
# Vide => aucun jeton configure => extractAuditClientHints renvoie
# NO_CLIENT_HINTS => provenance nulle, annoncee par l'UI : la direction sure.
# Pour l'activer, generez une valeur qui n'a jamais transite par git :
#   openssl rand -hex 32
AUDIT_FORWARD_TOKEN=

# SCHOOL_TIMEZONE : le fuseau DECLARE de l etablissement (S-E03-8 / PF-406,
# ADR-078 sect. D3). Identifiant IANA, ex. Europe/Paris, Africa/Abidjan.
#
# Ce n est PAS TZ : on ne change pas l horloge du processus, on declare celle de
# l ecole. Le conteneur web tourne en UTC (node:22-alpine, aucun TZ pose) ; tant
# que l ancre calendrier derivait son decalage de getTimezoneOffset(), toutes
# les bornes glissaient d une heure et un conge  toute la journee  s affichait
# la veille sur les trois portails.
#
# Vide => defaut du code, identique a celui de School.timezone / Tenant.timezone
# dans schema.prisma : Europe/Paris. Une valeur illisible est journalisee puis
# remplacee par ce defaut NOMME, jamais par le fuseau du processus.
#
# Reglage de DEPLOIEMENT, pas de locataire : la source multi-tenant correcte est
# Tenant.timezone renvoye par une lecture portail (PF-406, volet 2).
SCHOOL_TIMEZONE=Europe/Paris
