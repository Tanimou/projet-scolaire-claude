# Keep LF for files executed inside Linux containers / on the server, regardless
# of the contributor's core.autocrlf. A CR in a shell script breaks the shebang.
*.sh            text eol=lf
*.mjs           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile*     text eol=lf
*.json          text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.prisma        text eol=lf
.env*           text eol=lf

# The V3 routine mirror must stay byte-comparable to the installed artefacts under
# ~/.claude/scheduled-tasks/, which are always LF. Without this, a Windows checkout
# rewrites the mirror to CRLF and the documented drift check reports a false diff.
docs/daily-improvement-v3/routine/*.md  text eol=lf

# S-E04-1 — the recorded pre-fix sources behind the audit-provenance gate's AC-7
# negative control. `audit-provenance-gate.spec.ts` pins their sha256, so a Windows
# checkout that rewrote them to CRLF would change every digest. (The spec also
# normalises `\r\n` before hashing, so losing this line degrades gracefully rather
# than going red — belt and braces, because the digest is the tamper signal.)
apps/api/src/shared/audit/__fixtures__/pre-fix/*.ts.txt  text eol=lf
